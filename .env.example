# Somente desenvolvimento local. Valores ficticios, sem credenciais externas.
APP_ENV=local
DATABASE_ROLE=runtime
POSTGRES_DB=trading_bot_dev
POSTGRES_USER=trading_bot_dev
POSTGRES_PASSWORD=local_example_only
POSTGRES_PORT=5432
RUNTIME_POSTGRES_HOST=127.0.0.1
RUNTIME_POSTGRES_PORT=5432
RUNTIME_POSTGRES_DB=trading_bot_dev
TEST_POSTGRES_DB=trading_bot_test
# Uma hora conceitual por candle; 2 segundos reais = demonstracao acelerada.
SIMULATOR_ENABLED=true
SIMULATOR_SEED=42
SIMULATOR_START=2026-01-01T00:00:00Z
SIMULATOR_INTERVAL_SECONDS=2

# Fonte de dados; nunca habilita Trading API ou ordens.
MARKET_DATA_PROVIDER=simulator
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
MARKET_SYMBOLS=SPY,AAPL,TSLA
MARKET_TIMEFRAME=1h
# INERTE/legado: nenhuma linha de produção lê esta flag. scripts/smoke_test.py é um
# reporter offline do evaluation-lab e nunca fala com a Alpaca. Mantida apenas por
# compatibilidade com ambientes antigos; não autoriza nenhum smoke de broker.
RUN_ALPACA_SMOKE_TEST=0
